#!/usr/bin/env bash
# secret-paste: store a secret the user pastes into Infisical, without any agent seeing it.
#
# Agents: run this with the terminal tool (run_in_terminal), never with Bash and never
# by telling the user to use Claude Code's `!` prompt. Neither gives `read` a real
# terminal, so the paste is lost and an empty value is stored.
#
#   secret-paste KEY --env prod --path /products/foo --project <projectId>
#   secret-paste KEY --env prod --path /products/foo --project <id> --depot owner/repo [--workflow deploy.yml]
#
# --depot also sets the same value as a Depot CI secret for that repo.
set -euo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -ge 1 ] || usage
key="$1"; shift
env="" path="" project="" depot_repo="" workflow=""
while [ $# -gt 0 ]; do
  case "$1" in
    --env) env="$2"; shift 2 ;;
    --path) path="$2"; shift 2 ;;
    --project) project="$2"; shift 2 ;;
    --depot) depot_repo="$2"; shift 2 ;;
    --workflow) workflow="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $1" >&2; usage ;;
  esac
done
[ -n "$env" ] && [ -n "$path" ] && [ -n "$project" ] || { echo "--env, --path and --project are required." >&2; exit 2; }
[[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "Key must be UPPER_SNAKE_CASE: $key" >&2; exit 2; }

if [ ! -t 0 ]; then
  echo "No terminal on stdin, so a paste cannot be read. Run this in a Terminal tab, not through an agent's Bash or Claude Code's ! prompt." >&2
  exit 1
fi

printf 'Paste %s for Infisical %s %s, then press Return (input hidden): ' "$key" "$env" "$path"
IFS= read -rs value
echo
value="${value%$'\r'}"
if [ -z "$value" ]; then
  echo "Nothing was pasted. Nothing stored." >&2
  exit 1
fi

infisical secrets set "$key=$value" --env="$env" --path="$path" --projectId="$project" --silent >/dev/null
stored="$(infisical secrets get "$key" --env="$env" --path="$path" --projectId="$project" --plain --silent)"
if [ "$stored" != "$value" ]; then
  unset value stored
  echo "Infisical did not return the value just set. Check $key in $env $path." >&2
  exit 1
fi
echo "Saved $key to Infisical ($env $path, ${#value} characters)."

if [ -n "$depot_repo" ]; then
  args=(ci secrets set "$key" --from-stdin --repo "$depot_repo")
  [ -n "$workflow" ] && args+=(--workflow "$workflow")
  printf '%s' "$value" | depot "${args[@]}" >/dev/null
  echo "Saved $key to Depot CI for $depot_repo${workflow:+ ($workflow)}."
fi
unset value stored
